      <add name="OpenSessionInView" type="Spring.Data.NHibernate.Support.OpenSessionInViewModule, Spring.Data.NHibernate5" />
    </httpModules>
    <globalization culture="es-AR" uiCulture="es-AR" />
  </system.web>
