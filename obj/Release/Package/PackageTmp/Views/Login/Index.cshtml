<div id="popupLogin" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel"
     data-backdrop="static" data-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h3>
                    Acceso Usuarios
                </h3>
            </div>
            <div class="modal-body">
                @model  laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.Users
                @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { enctype = "form" }))
                {
                    @Html.HiddenFor(model => model.Id)

                    <div class="control-group">
                        <label class="control-label">
                            Usuario
                        </label>
                        <div class="controls">
                            @Html.TextBoxFor(model => model.Usuario, new { @class = "form-control", @placeholder = "Usuario" })
                        </div>
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            Contraseña
                        </label>
                        <div class="controls">
                            @Html.PasswordFor(model => model.Pass, new { @class = "form-control", @placeholder = "Contraseña" })
                            <p/>
                            <p/>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <input type="submit" value="Ingresar" class="btn btn-success" />
                        <input type="button" value="Cancelar" class="btn btn-default" onclick="location.href='@Url.Action("../Login")'" />
                    </div>
                    <div class="text-danger">
                        @ViewBag.error
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#popupLogin").modal();
    });
</script>

