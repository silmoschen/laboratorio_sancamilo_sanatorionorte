<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio Análisis Clinicos</title>
    <script src="~/Scripts/jquery-3.3.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js" type="text/javascript"></script>
    <script src="~/Scripts/toggle.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.min.js" type="text/javascript"></script>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/toggle.css" rel="stylesheet" />

    <script src="~/Scripts/ChartJS/Chart.min.js"></script>
    <script src="~/Scripts/ChartJS/utils.js"></script>
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">

        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <!--
                    <a href='@Url.Action("Index", "Home")'>
                    <img src='@Url.Content("~/Content/logo.jpg")' width='60px' />
                    </a>
                -->
                @Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })

            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            Protocolos
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu" role="menu">
                            <li>@Html.ActionLink("Resultados de Análisis Internación", "Index", "AnalisisResultadosInternacion")</li>
                            <li>@Html.ActionLink("Resultados de Análisis Ambulatorio", "Index", "AnalisisResultados")</li>
                        </ul>
                    </li>
                    @{
                        if (@Session["Rol"] != null)
                        {
                            if (@Session["Rol"].ToString().Equals("1"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        Estadísticas
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu" role="menu">
                                        <li>@Html.ActionLink("Reportes Estadísticos", "Index", "EstadisticasReportes")</li>
                                        <li>@Html.ActionLink("Gráficos estadísticos", "Index", "Estadisticas")</li>
                                    </ul>
                                </li>

                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        General
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu" role="menu">
                                        <li><a class="" href="/Users"><span class="fa fa-arrow-right">&nbsp;</span> Usuarios </a></li>
                                        <li><a class="" href="/Roles"><span class="fa fa-arrow-right">&nbsp;</span> Roles Usuarios </a></li>
                                        <li><a class="" href="/Logs"><span class="fa fa-arrow-right">&nbsp;</span> Log Usuarios </a></li>
                                        <li><a class="" href="/CambiarClave"><span class="fa fa-arrow-right">&nbsp;</span> Cambiar Contraseña </a></li>
                                        <li><a class="" href="/Parametros"><span class="fa fa-arrow-right">&nbsp;</span> Parámetros Generales </a></li>
                                    </ul>
                                </li>
                            }
                        }
                    }
                    @{
                        if (@Session["Rol"] != null)
                        {
                            if (@Session["Rol"].ToString().Equals("2"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        General
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu" role="menu">
                                        <li><a class="" href="/CambiarClaveLab"><span class="fa fa-arrow-right">&nbsp;</span> Cambiar Contraseña </a></li>
                                    </ul>
                                </li>
                            }
                        }
                    }
                    <li>@Html.ActionLink("Acerca de", "About", "Home")</li>
                    <li><a href="/Login">[cerrar session] us.: @Session["__useramam"]</i></a></li>
                </ul>
            </div>
        </div>
    </div>
    <br />
    <br />
    <br />
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - <b>laboratoriobioquimico</b> - <FONT SIZE="1"> Desarrollo: shmSOFT Silvio Moschen </FONT></p>
        </footer>
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>
<script type="text/javascript">
    function __num(n) {
        var r = n.replace('.', ',');
        return r;
    }
</script>
<script type="text/javascript">
    var inputs = $('input, textarea, select, checkbox').not(':input[type=button], :input[type=submit], :input[type=reset], :input[type=checkbox]');
    inputs.addClass('form-control');
</script>
<script type="text/javascript">
    function __num(n) {
        var r = n.replace('.', ',');
        return r;
    }

    function PadLeft(value, length) {
        return (value.toString().length < length) ? PadLeft("0" + value, length) :
            value;
    }
</script>

<script type="text/javascript">
    //session end

    var sessionTimeoutWarning = @Session.Timeout- 1;

    var sessionUser = '@Session["__useramam"]';
    var sessionInit = '@Session["__initam"]';

    if (sessionUser == '' & sessionInit == '') SessionEnd();

    var sTimeout = parseInt(sessionTimeoutWarning) * 60 * 1000;
    setTimeout('SessionEnd()', sTimeout);

    function SessionEnd() {
    window.location = "/Login";
    }
</script>