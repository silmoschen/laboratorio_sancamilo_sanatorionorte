<!-- Popup Fechas -->
<div id="searchFechaModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    ×
                </button>
                <h2>
                    Buscar Protocolo
                </h2>
                <div class="row">
                    <div class="col-sm-1">
                        Desde
                    </div>
                    <div class="col-sm-3">
                        <input type="date" id="txtdesde" />
                        <p />
                    </div>
                    <div class="col-sm-1">
                        Hasta
                    </div>
                    <div class="col-sm-3">
                        <input type="date" id="txthasta" />
                        <p />
                    </div>

                    <div class="col-sm-2">
                        <input type="button" class="btn btn-info" value="Buscar" onclick="searchProtocolFecha()" />
                    </div>

                    <div class="col-sm-2">
                        <div id="divespera">
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12" id="listafechas" style="height: 400px; overflow: auto;">
                        @Html.Partial("Protocolospaciente")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function searchProtocolFecha() {        
        var desde = document.getElementById('txtdesde').value;
        var hasta = document.getElementById('txthasta').value;

        if (desde.length != 10 || hasta.length != 10) {
            alert('Fecha Incorrecta');
            return;
        }

        $("#divespera").html('Procesando ...');
        var url = '/AnalisisResultados/searchProtocolosFechas/' + desde + '/' + hasta;
        $.get(url, function (result) {
            $("#listafechas").html(result);
            $("#divespera").html('');
        });
    }
</script>
