<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="laboratoriobioquimico" namespace="laboratoriobioquimico.ar.com.laboratoriobioquimico.entities">

  <class name="PacientesMails" table="pacientes_mails" dynamic-update="true">


    <id name="id" column ="id" type="string">
      <generator class="assigned"/>
    </id>    
    
    <property name="email" column="email" not-null="false" type="string"/>
    <many-to-one name="paciente" class="Pacientes" column="fk_paciente" />

  </class>

</hibernate-mapping>
