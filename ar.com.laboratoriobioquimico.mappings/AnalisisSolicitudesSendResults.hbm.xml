<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="laboratoriobioquimico" namespace="laboratoriobioquimico.ar.com.laboratoriobioquimico.entities">

  <class name="AnalisisSolicitudesSendResults" table="analisis_solicitudes_send_results" dynamic-update="true">


    <id name="id" column ="id" type="string">
      <generator class="assigned"/>
    </id>
    
    <property name="opt1" column="opt1" not-null="false" type="string"/>
    <property name="opt2" column="opt2" not-null="false" type="string"/>
    <property name="opt3" column="opt3" not-null="false" type="string"/>
    <property name="fechahora" column="fecha_hora" not-null="false" type="datetime"/>

    <many-to-one name="solicitud" class="AnalisisSolicitudes" column="fk_nrosolicitud" />

  </class>

</hibernate-mapping>
