<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="laboratoriobioquimico" namespace="laboratoriobioquimico.ar.com.laboratoriobioquimico.entities">

  <class name="Pacientes" table="pacientes" dynamic-update="true">


    <id name="codpac" column ="codpac" type="string" unsaved-value="0">
      <generator class="assigned"/>
    </id>
    
    <property name="nombre" column="nombre" not-null="false" type="string"/>   
    <property name="nrodoc" column="nrodoc" not-null="false" type="string"/>
    <property name="email" column="email" not-null="false" type="string"/>

  </class>

</hibernate-mapping>
