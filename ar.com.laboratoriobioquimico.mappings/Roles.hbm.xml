<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="laboratoriobioquimico" namespace="laboratoriobioquimico.ar.com.laboratoriobioquimico.entities">

  <class name="Roles" table="roles" dynamic-update="true">

    <cache usage="nonstrict-read-write" region="LongTerm" />

    <id name="Id" column ="ID" type="long" unsaved-value="0">
      <generator class="native"/>
    </id>
    
    <property name="Descrip" column="descrip" not-null="false" type="string"/>
    <property name="Nivel" column="nivel" not-null="false" type="int"/>

  </class>

</hibernate-mapping>
