<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="laboratoriobioquimico" namespace="laboratoriobioquimico.ar.com.laboratoriobioquimico.entities">

  <class name="AnalisisSolicitudesItems" table="analisis_solicitudes_items" dynamic-update="true">

    <cache usage="nonstrict-read-write" region="LongTerm" />

    <composite-id name="ID" class="AnalisisSolicitudesItemsPK">
      <key-property name="nrosolicitud" column="nrosolicitud" type="string"/>
      <key-property name="items" column="items" type="string"/>
    </composite-id>

    <property name="codigo" column="codigo" not-null="false" type="string"/>
    <property name="cargado" column="cargado" type="string"/>

    <many-to-one name="practica" class="Nomenclatura" column="fk_practica1" />
    <many-to-one name="nbu" class="Nbu" column="fk_practica2" />
    <many-to-one name="solicitud" class="AnalisisSolicitudes" column="fk_nrosolicitud" />

    <bag name="resultadoitem" inverse="true" cascade="all-delete-orphan">
      <key>
        <column name="fk_nrosolicitud"/>
        <column name="fk_items"/>
      </key>
      <one-to-many class="AnalisisSolicitudesItemsResultado"/>
    </bag>

  </class>

</hibernate-mapping>
