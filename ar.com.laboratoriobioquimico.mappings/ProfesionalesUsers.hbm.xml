<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="laboratoriobioquimico" namespace="laboratoriobioquimico.ar.com.laboratoriobioquimico.entities">

  <class name="ProfesionalesUsers" table="profesionales_users" dynamic-update="true">

    <cache usage="nonstrict-read-write" region="LongTerm" />

    <id name="idprof" column ="idprof" type="string" unsaved-value="0">
      <generator class="assigned"/>
    </id>
    
    <property name="user" column="user" not-null="false" type="string"/>
    <property name="pass" column="pass" not-null="false" type="string"/>

    <many-to-one name="profesional" class="Profesionales" column="fk_profesional" />    

  </class>

</hibernate-mapping>
