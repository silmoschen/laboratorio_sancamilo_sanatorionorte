<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio Análisis Clinicos</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.3.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap-jquery-bridge.js" type="text/javascript"></script>
    <script src="~/Scripts/ChartJS/Chart.min.js"></script>
    <script src="~/Scripts/ChartJS/utils.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
        <div class="container">
            <a href="@Url.Action("Index", "Home")" class="navbar-brand navbar-home" title="Inicio" aria-label="Inicio">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z" />
                    <path d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293z" />
                </svg>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-md-0">
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Protocolos
                        </a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Resultados de Análisis Internación", "Index", "AnalisisResultadosInternacion", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Resultados de Análisis Ambulatorio", "Index", "AnalisisResultados", null, new { @class = "dropdown-item" })</li>
                        </ul>
                    </li>
                    @{
                        if (@Session["Rol"] != null)
                        {
                            if (@Session["Rol"].ToString().Equals("1"))
                            {
                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Estadísticas
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>@Html.ActionLink("Reportes Estadísticos", "Index", "EstadisticasReportes", null, new { @class = "dropdown-item" })</li>
                                        <li>@Html.ActionLink("Gráficos estadísticos", "Index", "Estadisticas", null, new { @class = "dropdown-item" })</li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        General
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="/Users">Usuarios</a></li>
                                        <li><a class="dropdown-item" href="/Roles">Roles Usuarios</a></li>
                                        <li><a class="dropdown-item" href="/Logs">Log Usuarios</a></li>
                                        <li><a class="dropdown-item" href="/CambiarClave">Cambiar Contraseña</a></li>
                                        <li><a class="dropdown-item" href="/Parametros">Parámetros Generales</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    }
                    @{
                        if (@Session["Rol"] != null)
                        {
                            if (@Session["Rol"].ToString().Equals("2"))
                            {
                                <li class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        General
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="/CambiarClaveLab">Cambiar Contraseña</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    }
                    <li class="nav-item">@Html.ActionLink("Acerca de", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item"><a class="nav-link" href="/Login">[cerrar session] us.: @Session["__useramam"]</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; 2022 - @DateTime.Now.Year - <b>laboratoriobioquimico</b> - <FONT SIZE="1"> Desarrollo: shmSOFT Silvio Moschen </FONT></p>
        </footer>
    </div>
    @RenderSection("scripts", required: false)
</body>
</html>
<script type="text/javascript">
    function __num(n) {
        var r = n.replace('.', ',');
        return r;
    }
</script>
<script type="text/javascript">
    var inputs = $('input, textarea, select').not(':input[type=button], :input[type=submit], :input[type=reset], :input[type=checkbox], :input[type=radio], :input[type=file], :input[type=hidden], :input[type=image], :input[type=range], :input[type=color]');
    inputs.addClass('form-control');
</script>
<script type="text/javascript">
    function PadLeft(value, length) {
        return (value.toString().length < length) ? PadLeft("0" + value, length) :
            value;
    }
</script>

<script type="text/javascript">
    //session end

    var sessionTimeoutWarning = @Session.Timeout- 1;

    var sessionUser = '@Session["__useramam"]';
    var sessionInit = '@Session["__initam"]';

    if (sessionUser == '' & sessionInit == '') SessionEnd();

    var sTimeout = parseInt(sessionTimeoutWarning) * 60 * 1000;
    setTimeout('SessionEnd()', sTimeout);

    function SessionEnd() {
    window.location = "/Login";
    }
</script>
