@model laboratoriobioquimico.ar.com.laboratoriobioquimico.utiles.PaginadorGenerico<laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.Logs>
<div class="row">
    <div class="col-sm-12">
        @using (Html.BeginForm("Index", "Logs", FormMethod.Post, new { enctype = "form" }))
        {
            <div class="row">
                <div class="col-sm-4">
                    <input type="text" name="txtbuscar" value="" class="form-control" placeholder="Introduzca valor a buscar ..." />
                </div>
                <div class="col-sm-6">
                    <input type="submit" class="btn btn-info" value="Buscar" style="color:white" />
                </div>
            </div>
        }
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                Fecha / Hora
            </th>
            <th>
                Descripción
            </th>
            <th>
                Usuario
            </th>
        </tr>
    </thead>
    @{
        if (Model.Resultado != null)
        {
            foreach (var c in Model.Resultado) // Print the list
            {
                <tr>
                    <td valign="top">
                        @c.Fechahora
                    </td>
                    <td valign="top">
                        @c.Descrip
                    </td>
                    <td valign="top">
                        @{
                            if (c.User != null)
                            {
                                @c.User.Nombre
                            }
                        }
                    </td>
                </tr>
            }

        }
    }
</table>
@Html.Partial("_Paginador", Model)