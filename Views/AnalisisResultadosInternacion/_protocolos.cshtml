@model laboratoriobioquimico.ar.com.laboratoriobioquimico.utiles.PaginadorGenerico<laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.AnalisisSolicitudesInternacion>
<table class="table">
    <thead>
        <tr>
            <th>
                Fecha
            </th>
            <th>
                Protocolo
            </th>
            <th>
                Paciente
            </th>
            <th>
                Nro.Doc.
            </th>
            <th>
                Obra Social
            </th>
            <th>
                Profesional
            </th>     
            <th>
                Resultado
            </th>
        </tr>
    </thead>
    @{
        if (Model.Resultado != null)
        {
            foreach (var c in Model.Resultado) // Print the list
            {

                {
        <tr>
            <td valign="top">
                @c.fecha1
            </td>
            <td valign="top">
                @c.nrosolicitud
            </td>
            <td valign="top" width="20%">
	        @if (c.paciente != null)
                {
                @c.paciente.nombre
                }
            </td>
            <td valign="top">
                 @if (c.paciente != null)
                {
                @c.paciente.nrodoc
                }
            </td>
            <td valign="top" width="20%">
                
		@if (c.obrasocial != null)
                {
                    @c.obrasocial.nombre
                }

            </td>
            <td valign="top">
                @if (c.profesional != null)
                {
                    @c.profesional.nombre
                }
            </td>

            <td valign="top" width="15%">
                @{
                    if (@Session["Rol"] != null)
                    {
                        if (@Session["Rol"].ToString().Equals("2"))
                        {
                            <a href="javascript:onclick(loadResult('@c.nrosolicitud'))" class="btn btn-warning" style="color:white">
                                R
                            </a>
                        }
                        else
                        {
                            <a href="javascript:onclick(loadProtocol('@c.nrosolicitud'))" class="btn btn-info" style="color:white">
                                C
                            </a>
                        }
                    }
                }

                <a href="javascript:onclick(sendProtocol(`@c.nrosolicitud`))" class="btn btn-warning" style="color:white">
                    @@
                </a>

                @if (c.dcm4che)
                {
                    <a href="javascript:onclick(senddcm4che(`@c.nrosolicitud`))" class="btn btn-success" style="color:white">
                        D
                    </a>
                }

            </td>
        </tr>
                }

            }
        }
    }
</table>
