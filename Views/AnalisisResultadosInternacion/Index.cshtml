@model laboratoriobioquimico.ar.com.laboratoriobioquimico.utiles.PaginadorGenerico<laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.AnalisisSolicitudesInternacion>
<div class="row">
    <div class="col-sm-1">
        Protocolo
    </div>
    <div class="col-sm-2">
        <input type="text" id="idprotocolo" class="form-control" value="" />
    </div>
    <div class="col-sm-2">
        <input type="button" class="btn btn-primary" value="Buscar" style="color:white" onclick="searchProtocol()" />
    </div>
    <div class="col-sm-5">
        <input type="button" class="btn btn-success" value="Filtrar por Paciente" onclick="searchProtocolosPaciente()" />
        <input type="button" class="btn btn-success" value="Filtrar por Fecha" onclick="searchProtocolosFecha()" />
    </div>
    <div class="col-sm-2">
        <FONT SIZE="1">C: Carga</FONT>
        <FONT SIZE="1">@@: Email</FONT>
        <FONT SIZE="1">D: dcm4che</FONT>
    </div>
</div>
<p />
<div class="col-sm-12" id="listaprotocolos">
    @Html.Partial("_protocolos")
</div>
<script type="text/javascript">
    function loadProtocol(id) {
        var url = '/AnalisisResultadosInternacion/loadProtocol/' + id;
        window.location.href = url;
    }

    function searchProtocol() {
        var id = document.getElementById('idprotocolo').value;
        if (id == '') {
            alert('Protocolo Incorrecto ...!');
            return;
        }
        var url = '/AnalisisResultadosInternacion/loadProtocol/' + id;
        window.location.href = url;
    }

    function printProtocol(id) {
        var url = '/AnalisisResultadosInternacion/List/' + id;
        window.location.href = url;
    }

    function searchProtocolosPaciente() {
        $('#searchPacienteModal').modal('show');
    }

    function searchProtocolosFecha() {
        $('#searchFechaModal').modal('show');
    }

    function loadResult(id) {
        var url = '/AnalisisResultadosInternacion/PrintResult2/' + id;
        window.location.href = url;
    }

    function sendProtocol(id) {
        var url = '/AnalisisResultadosInternacion/SendMail/' + id;
        window.location.href = url;
    }

</script>

<div class="text-danger">
    @ViewBag.error
</div>

@Html.Partial("_Paginador", Model)


@Html.Partial("SearchFechas")
@Html.Partial("SearchPacientes")