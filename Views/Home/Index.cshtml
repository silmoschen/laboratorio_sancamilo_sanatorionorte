@{
    ViewBag.Title = "Inicio";
    var esAdministrador = Session["Rol"] != null && Session["Rol"].ToString() == "1";
    var colModulo = esAdministrador ? "col-md-4" : "col-md-6";
}

<div class="home-page">
    <div class="home-hero">
        <div class="row align-items-center g-4">
            <div class="col-md-auto text-center text-md-start">
                <img src="~/Report/logo.png" alt="Sanatorio Norte" class="home-logo" />
            </div>
            <div class="col-md">
                <p class="home-kicker">Laboratorio de análisis clínicos</p>
                <h1 class="home-title">Bienvenido al panel de protocolos</h1>
                <p class="home-lead mb-0">
                    Consulte y gestione resultados de pacientes internados y ambulatorios.
                    @if (Session["__useramam"] != null)
                    {
                        <span>Sesión iniciada como <strong>@Session["__useramam"]</strong>.</span>
                    }
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="@colModulo">
            <div class="card home-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="home-icon home-icon-internacion" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.5 5.034v1.1l.953-.55.5.867L9 7l.953.55-.5.866-.953-.55v1.1h-1v-1.1l-.953.55-.5-.866L7 7l-.953-.55.5-.866.953.55v-1.1h1ZM13.25 9a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25h-.5ZM13.25 11a.25.25 0 0 0-.25.25v.5c0 .138.112.25.25.25h.5a.25.25 0 0 0 .25-.25v-.5a.25.25 0 0 0-.25-.25h-.5ZM.5 1a.5.5 0 0 0 0 1h4.11l4.176 6.264a.5.5 0 0 0 .656.167l.81-.405L7.053 5.44l3.95-1.318L8.114 1H15.5a.5.5 0 0 0 0-1H.5ZM3.832 8.027 2.11 13H.5a.5.5 0 0 0 0 1h15a.5.5 0 0 0 0-1h-2.611l-.848-2.545-2.064.972L6.5 9H3.832Z"/>
                        </svg>
                    </div>
                    <h2 class="h5">Internaciones</h2>
                    <p class="text-secondary flex-grow-1">Protocolos y resultados de pacientes internados.</p>
                    <a class="btn btn-primary mt-2" href="@Url.Action("Index", "AnalisisResultadosInternacion")">Abrir internación</a>
                </div>
            </div>
        </div>
        <div class="@colModulo">
            <div class="card home-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="home-icon home-icon-ambulatorio" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M9.5 0a.5.5 0 0 1 .5.5.5.5 0 0 0 .5.5.5.5 0 0 1 .5.5V2a.5.5 0 0 1-.5.5h-5A.5.5 0 0 1 5 2v-.5a.5.5 0 0 1 .5-.5.5.5 0 0 0 .5-.5.5.5 0 0 1 .5-.5h3Z"/>
                            <path d="M3 2.5a.5.5 0 0 1 .5-.5H4a.5.5 0 0 0 0-1h-.5A1.5 1.5 0 0 0 2 2.5v12A1.5 1.5 0 0 0 3.5 16h9a1.5 1.5 0 0 0 1.5-1.5v-12A1.5 1.5 0 0 0 12.5 1H12a.5.5 0 0 0 0 1h.5a.5.5 0 0 1 .5.5v12a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5v-12Z"/>
                            <path d="M10 7a1 1 0 1 1 2 0v5a1 1 0 1 1-2 0V7Zm-6 4a1 1 0 1 1 2 0v1a1 1 0 1 1-2 0v-1Zm4-3a1 1 0 0 0-1 1v3a1 1 0 1 0 2 0V9a1 1 0 0 0-1-1Z"/>
                        </svg>
                    </div>
                    <h2 class="h5">Ambulatorio</h2>
                    <p class="text-secondary flex-grow-1">Protocolos y resultados de pacientes ambulatorios.</p>
                    <a class="btn btn-primary mt-2" href="@Url.Action("Index", "AnalisisResultados")">Abrir ambulatorio</a>
                </div>
            </div>
        </div>
        @if (esAdministrador)
        {
            <div class="col-md-4">
                <div class="card home-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="home-icon home-icon-estadistica" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5v12h-2V2h2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3z"/>
                            </svg>
                        </div>
                        <h2 class="h5">Estadísticas</h2>
                        <p class="text-secondary flex-grow-1">Gráficos y reportes de actividad del laboratorio.</p>
                        <a class="btn btn-outline-primary mt-2" href="@Url.Action("Index", "Estadisticas")">Ver estadísticas</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
