@{
    Layout = null;
}
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio Análisis Clinicos</title>
    <script src="~/Scripts/jquery-3.3.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js" type="text/javascript"></script>
    <script src="~/Scripts/toggle.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.min.js" type="text/javascript"></script>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/toggle.css" rel="stylesheet" />
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">

        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
            </div>
        </div>
    </div>
    <br />
    <br />
    <div class="container body-content">
        <div class="row">
            <div class="col-sm-4">
            </div>
            <div class="col-sm-3">

                <br />
                <img src="~/Report/logo.png" width="250px" />
                <br />

                @model  laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.Users
                @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { enctype = "form" }))
                {

                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)
                    <div class="control-group">
                        <label class="control-label">
                            Usuario
                        </label>
                        <div class="controls">
                            @Html.TextBoxFor(model => model.Usuario, new { @class = "form-control", @placeholder = "Usuario" })
                        </div>
                    </div>

                    <div class="control-group">
                        <label class="control-label">
                            Contraseña
                        </label>
                        <div class="controls">
                            @Html.PasswordFor(model => model.Pass, new { @class = "form-control", @placeholder = "Contraseña" })
                            <p />
                            <p />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <input type="submit" value="Ingresar" class="btn btn-success" />
                        <input type="button" value="Cancelar" class="btn btn-default" onclick="location.href='@Url.Action("../Login")'" />
                    </div>
                    <div class="text-danger">
                        @ViewBag.error
                    </div>
                }

            </div>

            <div class="col-sm-4">
            </div>

        </div>

        <div class="row">

            <div class="col-sm-4">
            </div>

            <div class="col-sm-4">
                @if (@Model.EntidadPie != null)
                {
                    
                    @:hola<p><pre style="border: 2px none; display: inline-block;">@Model.EntidadPie</pre></p>
                }
            </div>


            <div class="col-sm-4">
            </div>

        </div>

        <div class="row">

            <div class="col-sm-4">
            </div>

            <div class="col-sm-4">
                <p>&copy; 2022 - @DateTime.Now.Year - <FONT SIZE="1"> Desarrollo: shmSOFT Silvio Moschen </FONT></p>
            </div>


            <div class="col-sm-3">
            </div>

        </div>

    </div>


</body>
</html>
