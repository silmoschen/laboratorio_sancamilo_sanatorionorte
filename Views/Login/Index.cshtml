@model laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.Users
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laboratorio Análisis Clínicos</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <script src="~/Scripts/jquery-3.3.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap-jquery-bridge.js" type="text/javascript"></script>
</head>
<body class="login-page">
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container">
            <span class="navbar-brand mb-0">&emsp;</span>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-11 col-sm-8 col-md-5 col-lg-4">
                <div class="login-card">
                    <div class="text-center mb-4">
                        <img src="~/Report/logo.png" alt="Sanatorio Norte" class="login-logo" />
                        <p class="home-kicker mt-3">Laboratorio de análisis clínicos</p>
                        <h1 class="login-title">Ingreso al sistema</h1>
                    </div>

                    @using (Html.BeginForm("Login", "Login", FormMethod.Post))
                    {
                        @Html.HiddenFor(model => model.Id)
                        <div class="mb-3">
                            <label class="form-label" for="Usuario">Usuario</label>
                            @Html.TextBoxFor(model => model.Usuario, new { @class = "form-control", @placeholder = "Usuario", autocomplete = "username" })
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="Pass">Contraseña</label>
                            @Html.PasswordFor(model => model.Pass, new { @class = "form-control", @placeholder = "Contraseña", autocomplete = "current-password" })
                        </div>
                        if (ViewBag.error != null)
                        {
                            <div class="alert alert-danger py-2" role="alert">
                                @ViewBag.error
                            </div>
                        }
                        <div class="d-grid gap-2 mt-4">
                            <input type="submit" value="Ingresar" class="btn btn-primary" />
                            <input type="button" value="Cancelar" class="btn btn-outline-secondary" onclick="location.href='@Url.Action("Index", "Login")'" />
                        </div>
                    }
                </div>

                @if (Model != null && Model.EntidadPie != null)
                {
                    <div class="login-note">
                        @foreach (var line in Model.EntidadPie.Replace("\r\n", "\n").Split('\n'))
                        {
                            <p>@line</p>
                        }
                    </div>
                }

                <p class="login-footer">
                    &copy; 2022 - @DateTime.Now.Year · Desarrollo: shmSOFT Silvio Moschen
                </p>
            </div>
        </div>
    </div>
</body>
</html>
