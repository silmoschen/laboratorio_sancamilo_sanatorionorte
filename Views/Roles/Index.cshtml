@model laboratoriobioquimico.ar.com.laboratoriobioquimico.utiles.PaginadorGenerico<laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.Roles>
<div class="row">
    <div class="col-sm-12">
        @using (Html.BeginForm("Index", "Roles", FormMethod.Post, new { enctype = "form" }))
        {
            <div class="row">
                <div class="col-sm-4">
                    <input type="text" name="txtbuscar" value="" class="form-control" placeholder="Introduzca valor a buscar ..." />
                </div>
                <div class="col-sm-6">
                    <input type="submit" class="btn btn-info" value="Buscar" style="color:white" />
                    <input type="button" class="btn btn-primary" value="Nuevo" onclick="location.href='@Url.Action("Create", "Roles")'" />
                </div>
            </div>
        }
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                Descripción
            </th>
            <th>
                Nivel
            </th>
            <th>
                Editar
            </th>
            <th>
                Borrar
            </th>
        </tr>
    </thead>
    @{
        if (Model.Resultado != null)
        {
            foreach (var c in Model.Resultado) // Print the list
            {
                <tr>
                    <td valign="top" width="80%">
                        @c.Descrip
                    </td>
                    <td valign="top">
                        @c.Nivel
                    </td>
                    <td valign="top" width="5">
                        @using (Html.BeginForm("Delete", "Roles", new { id = c.Id }, FormMethod.Post, new { style = "display:inline;", onsubmit = "return confirm('Seguro para Eliminar Rol " + @c.Descrip + " ?');" }))
                        {
                            <input type="submit" value="Eliminar" class="btn btn-danger" color="white;" />
                        }
                    </td>
                    <td valign="top">
                        @Html.ActionLink("Editar", "Edit", "Roles", new { id = @c.Id }, new { @class = "btn btn-warning", @style = "color:white" })
                    </td>
                </tr>
            }

        }
    }
</table>
<p />
<div class="text-danger">
    @ViewBag.error
</div>
@Html.Partial("_Paginador", Model)
