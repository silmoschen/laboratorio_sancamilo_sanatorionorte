@model laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.AnalisisSolicitudes
@using (Html.BeginForm("PrintResult", "AnalisisResultados", FormMethod.Post, new { enctype = "form" }))
{
    <div class="row">
        <div class="col-sm-1">
            Prot/Id
        </div>
        <div class="col-sm-2">
            <b>
                @Html.DisplayFor(model => model.nrosolicitud)
            </b>
            <p />
        </div>
        <div class="col-sm-1">
            Paciente
        </div>
        <div class="col-sm-4">
            <b>
                @Html.DisplayFor(model => model.paciente.nombre)
            </b>
            <p />
        </div>
        <div class="col-sm-1">
            Fecha
        </div>
        <div class="col-sm-3">
            <b>
                @Model.fecha1
            </b>
            <p />
        </div>
    </div>
    <div class="row">
        <div class="col-sm-1">
            O.Social
        </div>
        <div class="col-sm-2">
            <b>
                @Html.DisplayFor(model => model.obrasocial.nombre)
            </b>
            <p />
        </div>
        <div class="col-sm-1">
            Médico
        </div>
        <div class="col-sm-3">
            <b>
                @Html.DisplayFor(model => model.profesional.nombre)
            </b>
            <p />
        </div>
        <div class="col-sm-1">
        </div>
        <div class="col-sm-4">
            <p />
        </div>
    </div>

    @Html.HiddenFor(model => model.nrosolicitud)

    var lista = Model.practicas;


    <div class="row">
        <div class="col-sm-5">
            <h2>Prácticas</h2>
        </div>
        <div class="col-sm-7">
            @if (@lista != null)
            {
                <br />
                <input type="button" value="Adjuntar Archivo(s)" class="btn btn-info" style = "color:white" onclick="adjuntarArchivos()" />
                <input type="submit" value="Generar Resultado" class="btn btn-success" />
                <input type="button" value="Retornar" class="btn btn-secondary" onclick="location.href='@Url.Action("IndexPag", "AnalisisResultados")'" />
            }

        </div>
    </div>

    <hr />

    if (@lista != null)
    {

        <table class="table">
            <thead>
                <tr>
                    <th>
                        Items
                    </th>
                    <th>
                        Código
                    </th>
                    <th>
                        Descripción Práctica
                    </th>
                    <th>
                        RC
                    </th>
                    <th>
                        Sel
                    </th>
                    <th>
                        Resultado
                    </th>
                </tr>
            </thead>


            @for (int i = 0; i < Model.practicas.Count; i++)
            {
                <tr>
                    <td valign="top">
                        @Model.practicas[i].ID.items
                        @Html.HiddenFor(model => model.practicas[i].ID.items)
                    </td>
                    <td valign="top">
                        @Model.practicas[i].codigo
                    </td>
                    <td valign="top" width="50%">
                        @Model.practicas[i].determinacion
                    </td>
                    <td valign="top">
                        @Model.practicas[i].cargado
                    </td>
                    <td valign="top">
                        @Html.CheckBoxFor(model => model.practicas[i].Select)
                    </td>
                    <td valign="top">
                        @Html.ActionLink("Cargar", "EditItem", "AnalisisResultados", new { id = @Model.practicas[i].ID.nrosolicitud, p2 = @Model.practicas[i].codigo, p3 = @Model.practicas[i].ID.items }, new { @class = "btn btn-primary", @style = "color:white" })
                    </td>
                </tr>
            }
        </table>
    }
}

<table>
    @{
        if (Model.archivosAdjuntos.Count > 0)
        {
            <tr>
                <td valign="top">
                    <h3>
                        Archivo(s) Adjunto(s)
                    </h3>
                </td>
            </tr>

            foreach (var c in Model.archivosAdjuntos) // Print the list
            {

                {
                    <tr>
                        <td valign="top" width="50%">
                            @c.Original
                        </td>
                        <td valign="top" align="right" width="10%">
                            <input type="button" value="X" onclick="deleteFile('@c.Id', '@c.Original', '@c.Protocolo')" />
                        </td>
                    </tr>

                }
            }
        }
    }
</table>


@Html.Partial("addFilesProtocol")

<div class="text-danger">
    @ViewBag.error
</div>

<script type="text/javascript">

    function adjuntarArchivos() {
        $('#addFilesProtocolModal').modal('show');
    }

    function deleteFile(file, orig, protocolo) {
        if (confirm('Seguro para Eliminar Archivo ' + orig + ' ?')) {
            var url = '/AnalisisResultados/ProtocolDeleteFile/' + protocolo + '/' + file;
            window.location.href = url;
        }
    }
</script>