@model laboratoriobioquimico.ar.com.laboratoriobioquimico.utiles.PaginadorGenerico<laboratoriobioquimico.ar.com.laboratoriobioquimico.entities.AnalisisSolicitudes>
<div class="row">
    <div class="col-sm-1">
        Protocolo
    </div>
    <div class="col-sm-2">
        <input type="text" id="idprotocolo" class="form-control" value="" />
    </div>
    <div class="col-sm-2">
        <input type="button" class="btn btn-primary" value="Buscar" style="color:white" onclick="searchProtocol()" />
    </div>
    <div class="col-sm-5">
        <input type="button" class="btn btn-success" value="Filtrar por Paciente" onclick="searchProtocolosPaciente()" />
        <input type="button" class="btn btn-success" value="Filtrar por Fecha" onclick="searchProtocolosFecha()" />
    </div>
    <div class="col-sm-2">
        <FONT SIZE="1">C: Carga</FONT>
        <FONT SIZE="1">@@: Email</FONT>
        <FONT SIZE="1">R: Resultado</FONT>
    </div>
</div>

<input type="hidden" id="__file" />

<p />
<div class="col-sm-12" id="listaprotocolos">
    @Html.Partial("_protocolos")
</div>
<script type="text/javascript">
    function loadProtocol(id) {
        var url = '/AnalisisResultados/loadProtocol/' + id;
        window.location.href = url;
    }

    function searchProtocol() {
        var id = document.getElementById('idprotocolo').value;
        if (id == '') {
            alert('Protocolo Incorrecto ...!');
            return;
        }
        var url = '/AnalisisResultados/loadProtocol/' + id;
        window.location.href = url;
    }

    function printProtocol(id) {
        var url = '/AnalisisResultados/List/' + id;
        window.location.href = url;
    }

    function searchProtocolosPaciente() {
        $('#searchPacienteModal').modal('show');
    }

    function searchProtocolosFecha() {
        var url = '/AnalisisResultados/getFechas/0';
        $.get(url, function (result) {

            if (result == null) {
                $('#searchFechaModal').modal('show');
            } else {
                document.getElementById('txtdesde').value = result.fecha1;
                document.getElementById('txthasta').value = result.fecha2;

                // Busqueda secundaria

                $("#divespera").html('Procesando ...');
                var url = '/AnalisisResultados/searchProtocolosFechas/' + result.fecha1 + '/' + result.fecha2;
                $.get(url, function (result) {
                    $("#listafechas").html(result);
                    $("#divespera").html('');

                    $('#searchFechaModal').modal('show');
                });
            }
        });

    }

    function loadResult(id) {
        var url = '/AnalisisResultados/PrintResult2/' + id;
        window.location.href = url;
    }

    function sendProtocol(id) {
        var url = '/AnalisisResultados/SendMail/' + id;
        window.location.href = url;
    }

    function list(c) {
        var f = document.getElementById('showskill');
        f.src = c;
        $('#listFile').modal('show');
    }

</script>

<div class="text-danger">
    @ViewBag.error
</div>

@Html.Partial("_Paginador", Model)


@Html.Partial("SearchFechas")
@Html.Partial("SearchPacientes")
@Html.Partial("ListFile")