<!-- Popup Archivos Protocolo -->
<div id="addFilesProtocolModal" class="modal fade" tabindex="-1" aria-labelledby="addFilesProtocolModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addFilesProtocolModalLabel">Adjuntar archivos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-5">
                        @using (Html.BeginForm("UploadFilesProtocol", "AnalisisResultados", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <input type="file" name="files" value="Seleccionar" accept=".pdf" multiple="multiple" class="form-control" />
                            <br />
                            <input type="submit" value="Adjuntar Archivo(s)" class="btn btn-success" />
                        }
                    </div>
                    <div class="col-sm-1">

                    </div>
                    <div class="col-sm-5">
                        <div id="divfiles">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
